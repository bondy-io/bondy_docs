{
  "name": "bondy_docs",
  "version": "1.0.0",
  "description": "Bondy Developer",
  "main": "index.js",
  "type": "module",
  "repository": "https://github.com/bondy-io/bondy_docs.git",
  "author": "Bondy Team",
  "license": "CC-BY-SA-4.0",
  "private": false,
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "markdownlint-cli": "^0.43.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.4.2",
    "vitepress": "^1.6.4"
  },
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "check:anchors": "node scripts/check-anchors.mjs",
    "docs:preview": "vitepress preview docs",
    "docs:serve": "vitepress preview docs",
    "format": "prettier --write \"docs/**/*.md\" \"*.md\"",
    "format:check": "prettier --check \"docs/**/*.md\" \"*.md\"",
    "lint:md": "markdownlint \"docs/**/*.md\" --ignore node_modules",
    "lint:md:fix": "markdownlint \"docs/**/*.md\" --ignore node_modules --fix",
    "spellcheck": "just spellcheck",
    "spellfix": "just spellfix",
    "outdated": "npm outdated",
    "check": "npm run format:check && npm run lint:md && npm run spellcheck",
    "docs:index": "pagefind --site docs/.vitepress/dist --output-path docs/.vitepress/dist/pagefind",
    "docs:release": "npm run docs:build && npm run docs:index"
  },
  "dependencies": {
    "@bondy/site-chrome": "github:bondy-io/bondy_site_chrome#v0.9.14",
    "@leapsight/vitepress-template": "git+https://github.com/Leapsight/vitepress-template.git#v0.1.19",
    "@sindresorhus/slugify": "^2.1.1",
    "@types/markdown-it": "^14.1.2",
    "markdown-it": "^14.1.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-custom-block": "^1.0.0",
    "sitemap": "^8.0.0"
  }
}
